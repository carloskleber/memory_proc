# Copy to .env and adjust. Loaded automatically by process.py.

# Where Marker/surya store downloaded model weights (~3 GB).
# Default is ~/.cache/datalab. Override when the home partition is tight —
# point it at a disk with several GB free, or downloads fail with
# "No space left on device". Example used during setup on this machine:
MODEL_CACHE_DIR=/var/tmp/datalab/models

# Optional tuning (see README). Loaded automatically by process.py.
# MARKER_PDFTEXT_WORKERS=2
# Pause after a failure/recycle before the GPU is handed a new context.
# MARKER_GPU_COOLDOWN_SEC=3
# Seconds before a stuck conversion is killed and retried more conservatively
# (CUDA only; 0 disables). Overridden by --timeout.
# MARKER_DOC_TIMEOUT_SEC=1800

# Only needed when running with --llm (Marker's LLM cleanup pass).
ANTHROPIC_API_KEY=sk-ant-...
